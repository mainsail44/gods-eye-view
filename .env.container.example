# God's Eye View — container configuration.
#
#   cp .env.container.example .env     # then fill in what you have
#   podman compose up -d --build
#
# Everything here is optional: a blank key just leaves that data source off, and
# the app still runs. Nothing in this file is baked into the image — the browser
# keys are injected into the built assets at container startup — so the image
# stays safe to push to a registry.
#
# Sign-up links for every key are at the bottom of this file.

# ── Base map ──────────────────────────────────────────────────────────────────
# These two are served to the browser, so page visitors can read them. Restrict
# them by HTTP referrer in the Google Cloud / Cesium ion consoles.
GOOGLE_MAPS_API_KEY=
CESIUM_ION_TOKEN=

# ── Server-side provider keys (never leave the container) ─────────────────────
GOOGLE_MAPS_SERVER_API_KEY=
OPENAI_API_KEY=
# Point model calls at any OpenAI-compatible runtime (Ollama, vLLM,
# llama.cpp). Leave unset to use OpenAI.
OPENAI_BASE_URL=
# Starlight Local Intel service, reached only from the server side.
STARLIGHT_INTEL_URL=http://starlight-intel:8080
# How long the app waits for an answer. A local model that reasons before it
# answers takes 20-60 seconds; the default is 120000 ms.
STARLIGHT_INTEL_TIMEOUT_MS=
OPENSKY_AUTH_MODE=oauth
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AISSTREAM_API_KEY=
FIRMS_MAP_KEY=
TOMTOM_API_KEY=
TFL_APP_KEY=
LL2_API_TOKEN=

# ── Starlight Local Intel (podman compose --profile intel) ────────────────────
# The intel profile answers questions about the bundled datacenter and cable
# landing-point data from a corpus built into its image. Out of the box it
# answers with a deterministic stub runtime: no GPU, no model download, and
# every stub answer says in its text that it is a stub.
#
# To answer with a real model instead, run an OpenAI-compatible runtime on this
# machine (Ollama, vLLM, llama.cpp) and set these three values. Nothing else
# changes — no file is edited, no image is rebuilt:
#
#   INTEL_RUNTIME_URL=http://host.containers.internal:11434
#   INTEL_MODEL=<a model your runtime has already pulled>
#   INTEL_RUNTIME=ollama
#   INTEL_REASONING_EFFORT=none
#
# That last one is worth having on a model that reasons before it answers: it
# is sent as the standard `reasoning_effort` field, and on a local 4B model it
# took one grounded answer from 80 seconds to 30 without changing what the
# answer said. Leave it empty for runtimes that reject unknown fields.
#
# The runtime URL is where your questions and the retrieved records are sent.
# Keep it on hardware you control: a hosted endpoint here would make the
# "nothing leaves this machine" claim untrue.
INTEL_RUNTIME_URL=
INTEL_MODEL=
INTEL_RUNTIME=
INTEL_REASONING_EFFORT=
# `auto` (the default) makes the service measure whether it can reach the
# public internet and report the result on /health. Set `blocked`, `allowed`
# or `unknown` to report a fixed value and skip the check.
INTEL_EGRESS=

# ── Optional tuning ───────────────────────────────────────────────────────────
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_MODEL_MINI=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_HUD_SUMMARY_MODEL=gpt-5-nano

# ══ Where to get each key ═════════════════════════════════════════════════════
#
# The main six — four have a free tier, two are metered (💳):
#
#   CESIUM_ION_TOKEN            🗺️  Photorealistic 3D, world terrain, ion imagery
#                               https://cesium.com/ion
#                               Use a public `assets:read` token. Free Community
#                               plan is personal/non-commercial with quotas:
#                               https://cesium.com/platform/cesium-ion/pricing/
#
#   GOOGLE_MAPS_API_KEY      💳 Google Photorealistic 3D + Google place search
#   GOOGLE_MAPS_SERVER_API_KEY  https://console.cloud.google.com/
#                               Enable the Map Tiles API; URL-restrict the key.
#                               Pricing: https://developers.google.com/maps/billing-and-pricing/pricing
#
#   OPENAI_API_KEY           💳 🎙️  Voice control + AI HUD summary
#                               https://platform.openai.com
#                               Never reaches the browser — the client only gets
#                               a short-lived session token.
#
#   AISSTREAM_API_KEY           🚢 Live global ships — free signup
#                               https://aisstream.io
#
#   FIRMS_MAP_KEY               🔥 Live active fires — free
#                               https://firms.modaps.eosdis.nasa.gov/api/map_key/
#
#   TOMTOM_API_KEY              🚦 Live traffic flow + congestion — free tier
#                               https://developer.tomtom.com
#                               Pricing: https://docs.tomtom.com/pricing/
#
# Cherry on top — these layers already work without a key; adding one only
# raises your polling/request allowance:
#
#   OPENSKY_CLIENT_ID           ✈️  More flight-polling credits
#   OPENSKY_CLIENT_SECRET       https://opensky-network.org
#                               OAuth client credentials live in the account
#                               dashboard once you register.
#
#   LL2_API_TOKEN               🚀 Higher space-missions request allowance
#                               https://thespacedevs.com
#                               API docs: https://ll.thespacedevs.com/docs/
#
#   TFL_APP_KEY                 📷 Higher rate limit on London JamCams CCTV
#                               https://tfl.gov.uk/info-for/open-data-users/
