# Starlight Local Intel - retrieval and inference service.
#
#   podman compose --profile intel up -d --build
#
#   podman build -t starlight-intel -f services/intel/Containerfile .
#   podman run --rm -p 8080:8080 \
#     -e INTEL_MODEL=<model> -e INTEL_RUNTIME_URL=<runtime> starlight-intel
#
# Build context is the repository root: the service shares
# src/sources/intelEndpoint.js with the application, and the corpus is built
# from the bundled datasets in the first stage below. There is no bind mount
# and no volume — the corpus ships inside the image, so the service has
# something to answer from wherever it is deployed, and /health reports a
# checksum of exactly the data that image carries.

FROM docker.io/library/node:24-slim AS corpus
WORKDIR /build
COPY services/intel/src/buildCorpus.js services/intel/src/corpus.js \
     services/intel/src/geo.js services/intel/src/gazetteer.js \
     /build/services/intel/src/
COPY services/intel/scripts/build-corpus.mjs /build/services/intel/scripts/
COPY src/data/local_data/datacenters/datacenters.geojsonl \
     /build/src/data/local_data/datacenters/
COPY src/data/local_data/telegeography_submarine_cables/landing-point-geo.json \
     /build/src/data/local_data/telegeography_submarine_cables/
# The vendored GeoNames slice places every record in its nearest town at
# build time and resolves the places questions name at run time.
COPY src/data/local_data/geonames/places.tsv.gz \
     src/data/local_data/geonames/admin1.tsv \
     src/data/local_data/geonames/admin2.tsv \
     src/data/local_data/geonames/countries.tsv \
     /build/src/data/local_data/geonames/
RUN node services/intel/scripts/build-corpus.mjs --out /corpus/corpus.json

FROM docker.io/library/node:24-slim AS runtime
WORKDIR /app

COPY services/intel/src /app/services/intel/src
# The deterministic stub runtime: the default `intel` profile answers with it
# so the deployment needs no GPU and browser assertions can be exact. Every
# stub answer says it is a stub.
COPY services/intel/test /app/services/intel/test
COPY src/sources/intelEndpoint.js /app/src/sources/intelEndpoint.js
COPY --from=corpus /corpus/corpus.json /app/corpus/corpus.json
COPY --from=corpus /build/src/data/local_data/geonames /app/gazetteer

# The vector index is embedded by the runtime on first start and cached here;
# compose mounts a volume on it so a restart reads the cache instead.
RUN mkdir -p /app/cache && chown node:node /app/cache
VOLUME /app/cache

ENV NODE_ENV=production \
    PORT=8080 \
    INTEL_CORPUS=/app/corpus/corpus.json \
    INTEL_GAZETTEER=/app/gazetteer \
    INTEL_EMBED_CACHE=/app/cache

EXPOSE 8080
USER node

CMD ["node", "/app/services/intel/src/index.js"]
